":"COMBO","widget":{"name":"index_mode"},"link":null},{"localized_name":"index_file","name":"index_file","shape":7,"type":"COMBO","widget":{"name":"index_file"},"link":null},{"localized_name":"auto_download","name":"auto_download","shape":7,"type":"BOOLEAN","widget":{"name":"auto_download"},"link":null}],"outputs":[{"localized_name":"rvc_model","name":"rvc_model","type":"RVC_MODEL","links":[9]},{"localized_name":"model_info","name":"model_info","type":"STRING","links":null}],"title":"Your RVC model (.pth in models/TTS/RVC)","properties":{"Node name for S&R":"LoadRVCModelNode"},"widgets_values":["my_voice_model.pth","auto","",true],"widgets_values_named":{"model":"my_voice_model.pth","index_mode":"auto","index_file":"","auto_download":true}},{"id":11,"type":"PreviewAudio","pos":[1660,160],"size":[300,100],"flags":{},"order":11,"mode":2,"inputs":[{"localized_name":"audio","name":"audio","type":"AUDIO","link":10},{"localized_name":"audioUI","name":"audioUI","type":"AUDIO_UI","widget":{"name":"audioUI"},"link":null}],"outputs":[{"localized_name":"audio","name":"audio","type":"AUDIO","links":null}],"title":"Preview (after RVC)","properties":{"Node name for S&R":"PreviewAudio"},"widgets_values":[],"widgets_values_named":{}},{"id":12,"type":"MarkdownNote","pos":[380,800],"size":[340,360],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["# IndexTTS-2.5 English / Japanese\n\n**Speaker voice** = who it sounds like. Trim 12 s of continuous speech: no silence at the start, no break over ~0.6 s (gaps in the sample = dead air in the result).\n\n**Japanese**: set `language` on the engine to Japanese and type normally. Fix a reading with `<私|わたし>`.\n\n**Sentence pauses**: put `[pause:0.8s]` between sentences (any length, e.g. `[pause:0.5s]`, `[pause:1s]`).\n\n**Speed**: keep `duration_factor` at 1.0 with pause tags (each tagged sentence already comes out slower). 1.1 if it still sounds rushed.\n\n**Emotion** (pick one or blend):\n- *Sliders*: Happy 0.2 + Calm 0.4 = soft and warm. Ctrl+B on the node for a neutral read.\n- *Emotion reference*: Ctrl+B on the bypassed clip and load a whispery/sultry sample. Tone comes from it, voice stays the speaker's.\n- `emotion_alpha` on the engine = strength (0.6-0.8 keeps the voice likeness).\n\n**RVC**: put your .pth in `models/TTS/RVC/`, select all 4 muted RVC nodes and press Ctrl+M.\n\nFirst run downloads the IndexTTS-2.5 model (about 5.5 GB) if it is not in `models/TTS/IndexTTS/IndexTTS-2.5/`."],"widgets_values_named":{"text":"# IndexTTS-2.5 English / Japanese\n\n**Speaker voice** = who it sounds like. Trim 12 s of continuous speech: no silence at the start, no break over ~0.6 s (gaps in the sample = dead air in the result).\n\n**Japanese**: set `language` on the engine to Japanese and type normally. Fix a reading with `<私|わたし>`.\n\n**Sentence pauses**: put `[pause:0.8s]` between sentences (any length, e.g. `[pause:0.5s]`, `[pause:1s]`).\n\n**Speed**: keep `duration_factor` at 1.0 with pause tags (each tagged sentence already comes out slower). 1.1 if it still sounds rushed.\n\n**Emotion** (pick one or blend):\n- *Sliders*: Happy 0.2 + Calm 0.4 = soft and warm. Ctrl+B on the node for a neutral read.\n- *Emotion reference*: Ctrl+B on the bypassed clip and load a whispery/sultry sample. Tone comes from it, voice stays the speaker's.\n- `emotion_alpha` on the engine = strength (0.6-0.8 keeps the voice likeness).\n\n**RVC**: put your .pth in `models/TTS/RVC/`, select all 4 muted RVC nodes and press Ctrl+M.\n\nFirst run downloads the IndexTTS-2.5 model (about 5.5 GB) if it is not in `models/TTS/IndexTTS/IndexTTS-2.5/`."},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,2,0,"AUDIO"],[2,2,0,6,1,"*"],[3,3,0,5,1,"*"],[4,4,0,5,0,"*"],[5,5,0,6,0,"TTS_ENGINE"],[6,6,0,7,0,"AUDIO"],[7,6,0,8,1,"*"],[8,9,0,8,0,"TTS_ENGINE"],[9,10,0,8,2,"*"],[10,8,0,11,0,"AUDIO"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.8000000000000022,"offset":[817.1406949492363,630.5640764458784]}},"version":0.4}